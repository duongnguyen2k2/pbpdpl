@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model API.Areas.Admin.Models.LegalQA.LegalQAModel
@using Microsoft.AspNetCore.Http;
@using Newtonsoft.Json;

@{
    Layout = "Templates/" + Context.Session.GetString("TemplateName") + "/_LayoutNoneCaptcha";
    string domain = "";
    if (Context.Request.IsHttps)
    {
        domain = "https://" + Context.Request.Host;
    }
    else
    {
        domain = "http://" + Context.Request.Host;
    }

    string ControllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    string StrThongTinCoQuan = Context.Session.GetString("ThongTinCoQuan");
    API.Areas.Admin.Models.DMCoQuan.DMCoQuan ItemCoQuan = JsonConvert.DeserializeObject<API.Areas.Admin.Models.DMCoQuan.DMCoQuan>(StrThongTinCoQuan);

    ViewData["Title"] = "| " + ItemCoQuan.Title;
    ViewData["Description"] = "Hỏi đáp pháp luật";
    ViewData["Keywords"] = "Hỏi đáp pháp luật";
    ViewData["Url"] = domain + "/hoi-dap-phap-luat.html";
    ViewData["Images"] = domain + "/avatar_hoi_dap.jpg?v=" + DateTime.Now.ToString("yyyyMMddhh");
    ViewData["Alias"] = "Hỏi đáp pháp luật";
    ViewData["Type"] = "article";

    var formStartTime = DateTime.Now.Ticks;
}

<div class="row">
    <div class="col-lg-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hỏi đáp pháp luật @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 col-md-12 col-12 mb-3">
        <div class="card legalqa-sidecard border-0 shadow-sm">
            <div class="card-body">
                <h5 class="legalqa-title">Hỏi đáp pháp luật</h5>
                <p class="legalqa-desc mb-3">
                    Gửi câu hỏi pháp luật để được bộ phận chuyên môn tiếp nhận và phản hồi.
                </p>
                <a class="btn btn-success btn-sm mr-2 mb-2" asp-controller="LegalQA" asp-action="List">
                    <i class="fas fa-comments"></i> Xem câu trả lời
                </a>
                <a class="btn btn-outline-primary btn-sm mb-2" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home"></i> Trang chủ
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-8 col-md-12 col-12">
        <div class="white-box mb-4 legalqa-form-wrap">
            <div class="legalqa-form-header">
                <h4 class="mb-1">Gửi câu hỏi pháp luật</h4>
                <small class="text-muted">Các trường có dấu (*) là bắt buộc.</small>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <partial name="_PartialMsgInfo" />
            <form asp-controller="@ControllerName" asp-action="Index" method="post" id="legalQaForm">
                <div style="position:absolute; left:-9999px; opacity:0;">
                    <input type="text" name="Website" tabindex="-1" autocomplete="off" />
                </div>
                <input type="hidden" name="FormStartTime" value="@formStartTime" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Item.Fullname">Họ tên <sup class="text-danger">(*)</sup></label>
                            <input type="text" class="form-control" asp-for="Item.Fullname" name="Fullname">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Item.Phone">Điện thoại</label>
                            <input type="text" class="form-control" asp-for="Item.Phone" name="Phone">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Item.Address">Địa chỉ</label>
                            <input type="text" class="form-control" asp-for="Item.Address" name="Address">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Item.Email">Email</label>
                            <input type="text" class="form-control" asp-for="Item.Email" name="Email">
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Item.Title">Tiêu đề <sup class="text-danger">(*)</sup></label>
                    <input type="text" asp-for="Item.Title" name="Title" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Item.Introtext">Nội dung câu hỏi <sup class="text-danger">(*)</sup></label>
                    <textarea asp-for="Item.Introtext" name="Introtext" class="form-control"></textarea>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-12 text-center">
                        <button type="submit" class="btn btn-primary btn-sm px-4" name="SaveItem" id="SaveLegalQA">
                            <i class="far fa-paper-plane"></i> Gửi câu hỏi
                        </button>
                        <a class="btn btn-success btn-sm px-4" asp-controller="LegalQA" asp-action="List">
                            <i class="fas fa-comments"></i> Xem câu trả lời
                        </a>
                    </div>
                </div>

                <input type="hidden" class="form-control" asp-for="Item.Id" name="Id">
                <input type="hidden" class="form-control" asp-for="Item.Ids" name="Ids">
                <input type="hidden" class="form-control" name="Token" id="recaptchaToken" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["RecaptchaSettings:SiteKey"]"></script>
    <script>
        grecaptcha.ready(function () {
            grecaptcha.execute('@Configuration["RecaptchaSettings:SiteKey"]', { action: 'contact_submit' })
                .then(function (token) {
                    document.getElementById('recaptchaToken').value = token;
                });
        });

        setInterval(function () {
            grecaptcha.execute('@Configuration["RecaptchaSettings:SiteKey"]', { action: 'contact_submit' })
                .then(function (token) {
                    document.getElementById('recaptchaToken').value = token;
                });
        }, 90000);

        document.getElementById('legalQaForm').addEventListener('submit', function () {
            const btn = document.getElementById('SaveLegalQA');
            btn.disabled = true;
        });
    </script>
}

<style>
    .legalqa-sidecard {
        border-radius: 8px;
    }

    .legalqa-title {
        font-weight: 700;
        color: #1f2d3d;
    }

    .legalqa-desc {
        color: #5c6b7a;
        font-size: 14px;
        line-height: 1.6;
    }

    .legalqa-form-wrap {
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .legalqa-form-header {
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 15px;
        padding-bottom: 12px;
    }
</style>
